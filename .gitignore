# Qt specific
*.pro.user
*.pro.user.*
*.autosave
.moc/
obj/
*.o

# Compiled files
*.exe
*.dll
*.so
*.dylib
*.a

# Vendored onnxruntime: 运行时库不入库（仅头文件与模型资产入库）
third_party/onnxruntime/lib/

# IDE specific
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
/bin/
/lib/
build/
build-*/

# Qt build folders
cmake-build-*/
Makefile*
*.mk

# Documentation builds
*.pdf
*.html
# 放行 UI 原型 HTML（覆盖上面的 *.html 忽略规则）
!docs/ui/prototypes/**/*.html

# Temporary files
*.tmp
*.bak
*.cache

# Test runtime artifacts (MOS 导出产物等运行时生成文件)
mos-sim-scenario-*.json

# Logs
logs/

# Local environment and secrets
.env
.env.*
!.env.example

# OMO runtime state
.omo/run-continuation/
.omo/ulw-loop/
.omo/ralph-loop.local.md
.omo/sessions/
.omo/cache/
.omo/tmp/
.omo/boulder.json
.omo/evidence/
.omo/drafts/
.omo/start-work/

# Agent cross-session memory (runtime state)
.workbuddy/

# UI prototype npm dependencies (Playwright 等，本地安装不提交)
docs/ui/prototypes/node_modules/
docs/ui/prototypes/package-lock.json
