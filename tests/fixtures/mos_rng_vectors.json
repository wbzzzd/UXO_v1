  "draw_order": {
    "crater": [
      "visibleRadius",
      "x",
      "y",
      {
        "threat": "仅 i>0 抽取"
      }
    ],
    "uxo": [
      "syntheticYield",
      "x",
      "y",
      "threat"
    ],
    "note": "JS Math.round 半数向正无穷（+∞）语义"
